# ============================================================
# ResearchFlow .gitattributes
# 目的：固定文本换行，保证 state_sync.py check 的逐字节比较
#       在 Windows（core.autocrlf=true）与其他环境一致。
# ============================================================

* text=auto

# 属性文件自身固定 LF，避免 core.autocrlf=true 下被改写
/.gitattributes text eol=lf

# 生成文件、脚本、契约与文档统一 LF
*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.log  text eol=lf
*.txt  text eol=lf
*.in   text eol=lf
*.lock text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# 二进制文档不参与换行转换
*.docx binary

# 证据包与离线验签材料按原始字节保存：包内 manifest 的 SHA-256 基于
# 生成时的原始字节，换行归一化会导致新 clone 中 verify_bundle 失败。
/docs/verification/t0/e2e/** -text
/docs/verification/t0/g6-t0/** -text
