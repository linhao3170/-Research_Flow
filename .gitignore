# ============================================================
# ResearchFlow .gitignore
# 原则：只忽略明确的本机/运行时/敏感内容；
#       不忽略业务数据、合成数据、测试 fixture、契约与文档。
# ============================================================

# ---- 1. 环境变量与本地密钥 ----
.env
.env.*
!.env.example

# 私钥 / 证书私钥（公钥证书 .crt/.cer 不忽略）
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*

# 本地专用配置：约定以 .local 结尾的变体不入库
*.local.json
*.local.yaml
*.local.yml
*.local.toml
/secrets/

# ---- 2. Python ----
.venv/
venv/
__pycache__/
*.py[cod]

# ---- 3. 测试与类型检查缓存 ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ---- 4. 运行数据、缓存、临时目录与日志 ----
# 只忽略明确目录；不使用 *.db / *.sqlite 全局规则，
# 避免误伤 tests/fixtures 下需要提交的数据库 fixture。
/runtime/
/data/runtime/
/data/cache/
/cache/
/.cache/
/tmp/
/temp/
/logs/
/*.log
*.tmp
*.temp

# ---- 5. 策划书原件（精确文件名，不扩展到 *.docx）----
# 只忽略根目录这一份冻结原件；其他 .docx（如后续验收导出件）仍可入库。
/ResearchFlow_3.1_项目策划书_v4.3.1_完整开发版.docx

# ---- 6. 本机 Agent 覆盖文件 ----
AGENTS.local.md
CLAUDE.local.md

# ---- 7. 未脱敏敏感资料目录 ----
# docs/reference/inbox/ 不忽略：仅登记可入库资料；
# 敏感原件必须放入 private/。
/docs/reference/private/
/data/private/

# ---- 8. 操作系统杂项 ----
.DS_Store
Thumbs.db
desktop.ini
