{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchflow.invalid/contracts/nodespec/1.0/nodespec.schema.json",
  "title": "NodeSpec v1.0",
  "description": "ResearchFlow 节点规格。来源：策划书附录 D.2；字段规则见 docs/design/05_CONTRACTS_AND_STATES.md §3。schema_version 由用户 2026-11-09 决议补入（ADR-003）。",
  "$comment": "side_effect_class 枚举已于 2026-11-10 按 v1.0 现值冻结（PURE_FUNCTION/PURE_ARTIFACT/SIDE_EFFECT 三值；新增成员按 MINOR，删除或改语义按 MAJOR）。自依赖与成环无法用 JSON Schema 表达，见 semantic 检查 SEM-NS-01 与 DAG Builder 的图级校验。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "node_id",
    "node_type",
    "template_id",
    "depends_on",
    "input_refs",
    "parameters_hash",
    "side_effect_class",
    "retry_policy",
    "required_checks"
  ],
  "properties": {
    "schema_version": {
      "description": "契约版本，本版固定 1.0。",
      "const": "1.0"
    },
    "node_id": {
      "description": "任务内唯一；不得含路径分隔符。示例 train_random_forest。",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "node_type": {
      "description": "节点类型，必须在域包允许类型内。示例 ml.train.classifier。",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "template_id": {
      "description": "已注册模板标识。",
      "$ref": "#/$defs/nameVersion"
    },
    "depends_on": {
      "description": "前驱节点 ID 列表；必须存在、不得自依赖、不得成环（图级校验）。",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      }
    },
    "input_refs": {
      "description": "输入产物引用；必须可解析到已有产物。",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^artifact://[A-Za-z0-9][A-Za-z0-9._/-]*$"
      }
    },
    "parameters_hash": {
      "description": "解析后参数的哈希；必须与参数一致。",
      "$ref": "#/$defs/sha256"
    },
    "side_effect_class": {
      "description": "副作用类别。v1.0 冻结三值；按 MINOR 可变：新增成员升 MINOR，删除或改语义升 MAJOR。",
      "enum": ["PURE_FUNCTION", "PURE_ARTIFACT", "SIDE_EFFECT"]
    },
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts", "backoff_sec"],
      "properties": {
        "max_attempts": {
          "description": "最大尝试次数（含首次）；0 与负数拒绝。T0 模板默认 2 为模板注册表约束，非契约上限。",
          "type": "integer",
          "minimum": 1
        },
        "backoff_sec": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "required_checks": {
      "description": "必检项 ID 列表；必须在规则集存在，空数组拒绝。",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nameVersion": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*@\\d+\\.\\d+\\.\\d+$"
    }
  }
}